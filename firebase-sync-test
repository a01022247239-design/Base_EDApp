export const DEFAULT_CHILDREN: ChildData[] = [
  { id: '01', name: '김지우', photo: null, badgeCount: 3 },
  { id: '02', name: '이준', photo: null, badgeCount: 1 },
  { id: '03', name: '박서아', photo: null, badgeCount: 5 },
  { id: '04', name: '최민준', photo: null, badgeCount: 2 },
];

const STORAGE_KEY_AGENT = 'petal_eco_agent_v4';
const STORAGE_KEY_CARD = 'petal_eco_card_v4';
const STORAGE_KEY_SCREEN = 'petal_eco_screen_v4';
const STORAGE_KEY_BADGES = 'petal_eco_badges_v4';
const STORAGE_KEY_ACTIVE_CHILD_ID = 'petal_eco_active_child_id';

export default function App() {
  const [currentScreen, setCurrentScreen] = useState<ScreenId>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_SCREEN);
      if (saved && ['screen1', 'screen2', 'screen4', 'screen5'].includes(saved)) {
        return saved as ScreenId;
      }
    } catch {
      // ignore
    }
    return 'screen1';
  });

  const [badgeCount, setBadgeCount] = useState<number>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_BADGES);
      if (saved) return parseInt(saved, 10);
    } catch {
      // ignore
    }
    return 0;
  });

  const [selectedCard, setSelectedCard] = useState<EcoCard | null>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_CARD);
      if (saved) return JSON.parse(saved);
    } catch {
      // ignore
    }
    return sampleCards[0];
  });

  const [agent, setAgent] = useState<AgentProfile>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_AGENT);
      if (saved) return JSON.parse(saved);
    } catch {
      // ignore
    }
    return {
      name: '김지우',
      className: '꽃잎반',
      title: '지구 지킴이',
      level: 1,
      xp: 50,
      maxXp: 100,
      avatar: '👦',
      photoUrl: null,
      qrCodeData: 'FLOWER-KIMJIWOO-2026',
      badge: '🌸 지구 지킴이',
      missionsCompleted: 12,
      totalMissions: 20,
      streakDays: 3,
    };
  });

  const [childrenList, setChildrenList] = useState<ChildData[]>([]);
  const [activeChildId, setActiveChildId] = useState<string | null>(() => {
    try {
      return localStorage.getItem(STORAGE_KEY_ACTIVE_CHILD_ID) || null;
    } catch {
      return null;
    }
  });

  const [activeBadge, setActiveBadge] = useState<{ icon: string; name: string; desc?: string } | null>(null);
  const [isAdminOpen, setIsAdminOpen] = useState(false);
  const [isMuted, setIsMuted] = useState(false);

  useEffect(() => {
    const unsubscribe = subscribeToFirebase((data) => {
      if (data) {
        const list: ChildData[] = Array.isArray(data) ? data : Object.values(data);
        setChildrenList(list);

        if (activeChildId) {
          const foundChild = list.find((c) => c && c.id === activeChildId);
          if (foundChild) {
            setAgent((prev) => ({
              ...prev,
              name: foundChild.name ?? prev.name,
              photoUrl: foundChild.photo !== undefined ? foundChild.photo : prev.photoUrl,
            }));
            if (foundChild.badgeCount !== undefined) {
              setBadgeCount(foundChild.badgeCount);
            }
          }
        }
      }
    }, DEFAULT_CHILDREN);

    return () => {
      if (typeof unsubscribe === 'function') {
        unsubscribe();
      }
    };
  }, [activeChildId]);

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY_SCREEN, currentScreen);
    } catch {
      // ignore
    }
  }, [currentScreen]);

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY_BADGES, badgeCount.toString());
    } catch {
      // ignore
    }
  }, [badgeCount]);

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY_CARD, JSON.stringify(selectedCard));
    } catch {
      // ignore
    }
  }, [selectedCard]);

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY_AGENT, JSON.stringify(agent));
    } catch {
      // ignore
    }
  }, [agent]);

  useEffect(() => {
    try {
      if (activeChildId) {
        localStorage.setItem(STORAGE_KEY_ACTIVE_CHILD_ID, activeChildId);
      } else {
        localStorage.removeItem(STORAGE_KEY_ACTIVE_CHILD_ID);
      }
    } catch {
      // ignore
    }
  }, [activeChildId]);

  const handleNavigateToMission = (badge?: { icon: string; name: string; desc?: string }) => {
    sounds.playClick();
    setActiveBadge(badge || null);
    setCurrentScreen('screen4');
  };

  const handleScanComplete = (
    card?: EcoCard,
    childData?: { id: string; name: string; photo?: string | null; badgeCount?: number }
  ) => {
    if (childData) {
      setActiveChildId(childData.id);
      setAgent((prev) => ({
        ...prev,
        name: childData.name,
        photoUrl: childData.photo !== undefined ? childData.photo : prev.photoUrl,
      }));
      if (childData.badgeCount !== undefined) {
        setBadgeCount(childData.badgeCount);
      }
    } else if (card) {
      setSelectedCard(card);
      setAgent((prev) => ({
        ...prev,
        name: card.agentName,
        title: card.agentTitle,
        avatar: card.avatar,
        level: card.level,
        badge: `🌸 ${card.agentTitle}`,
      }));
    }

    setCurrentScreen('screen5');
  };

  const handlePledgeComplete = async () => {
    sounds.playLevelUp();
    const newCount = Math.min(6, badgeCount + 1);
    setBadgeCount(newCount);

    if (activeChildId && childrenList.length > 0) {
      const updatedChildren = childrenList.map((child) => {
        if (child && child.id === activeChildId) {
          return {
            ...child,
            badgeCount: newCount,
          };
        }
        return child;
      });

      try {
        await syncWithFirebase(updatedChildren);
      } catch (err) {
        console.error('Firebase 배지 동기화 실패:', err);
      }
    }

    setCurrentScreen('screen5');
  };

  const handleUpdateChildrenData = async (newChildren: ChildData[]) => {
    setChildrenList(newChildren);
    try {
      await syncWithFirebase(newChildren);
    } catch (err) {
      console.error('Firebase 원아 목록 동기화 실패:', err);
    }
  };

  const handleReset = () => {
    sounds.playClick();
    setBadgeCount(0);
    setActiveChildId(null);
    setCurrentScreen('screen1');
    localStorage.clear();
  };

  const toggleSound = () => {
    const muted = sounds.toggleMute();
    setIsMuted(muted);
  };

  return (
    <div className="w-full h-screen bg-[#E5EFE2] flex items-center justify-center p-2 md:p-4 font-sans select-none overflow-hidden">
      {/* Mobile Frame Container */}
      <div className="w-full max-w-[430px] h-full max-h-[920px] bg-[#FAFCF7] rounded-[36px] shadow-2xl border-[6px] border-[#386627]/20 flex flex-col overflow-hidden relative">
        
        {/* Header Bar */}
        <header className="w-full px-5 py-3 bg-[#EBF5E6] border-b border-[#D5E6CF] flex items-center justify-between shrink-0 z-20">
          <button
            onClick={() => {
              sounds.playClick();
              setCurrentScreen('screen1');
            }}
            className="flex items-center gap-2 cursor-pointer group text-left"
          >
            <div className="w-8 h-8 rounded-full bg-[#386627] text-white flex items-center justify-center font-black text-sm shadow">
              🌱
            </div>
            <div>
              <h1 className="text-sm font-extrabold text-[#2D4A22] leading-tight group-hover:text-[#386627]">
                꽃잎반 지구 지킴이
              </h1>
              <p className="text-[10px] text-[#5B7B4C] font-semibold">ESG 환경 교육 키오스크</p>
            </div>
          </button>

          <div className="flex items-center gap-1.5">
            {/* Audio Toggle Button */}
            <button
              onClick={toggleSound}
              className="p-2 rounded-xl bg-white text-[#386627] border border-[#A8D08D] hover:bg-[#F2F8EE] cursor-pointer transition-colors shadow-xs"
              title={isMuted ? '음소거 해제' : '음소거'}
            >
              {isMuted ? <VolumeX className="w-4 h-4" /> : <Volume2 className="w-4 h-4" />}
            </button>

            {/* Admin Management Modal Trigger */}
            <button
              onClick={() => {
                sounds.playClick();
                setIsAdminOpen(true);
              }}
              className="p-2 rounded-xl bg-[#386627] text-white hover:bg-[#2D4A22] cursor-pointer transition-colors shadow-xs flex items-center justify-center"
              title="교사용 관리자 설정"
            >
              <ShieldCheck className="w-4 h-4" />
            </button>
          </div>
        </header>

        {/* Dynamic Screen View Content */}
        <main className="flex-1 overflow-hidden relative flex flex-col">
          {currentScreen === 'screen1' && (
            <Screen1Home
              agent={agent}
              badgeCount={badgeCount}
              onStartQR={() => {
                sounds.playClick();
                setCurrentScreen('screen2');
              }}
              onNavigateToMission={handleNavigateToMission}
            />
          )}

          {currentScreen === 'screen2' && (
            <Screen2QRScan
              onScanComplete={handleScanComplete}
              sampleCards={sampleCards}
              childrenList={childrenList}
            />
          )}

          {currentScreen === 'screen4' && (
            <Screen4MissionPledge
              agent={agent}
              activeBadge={activeBadge}
              onPledgeComplete={handlePledgeComplete}
            />
          )}

          {currentScreen === 'screen5' && (
            <Screen5Badge
              agent={agent}
              badgeCount={badgeCount}
              onHomeClick={() => {
                sounds.playClick();
                setCurrentScreen('screen1');
              }}
              onNavigateToMission={handleNavigateToMission}
            />
          )}
        </main>

        {/* Global Reset Button Footer */}
        <footer className="w-full py-2 bg-[#F2F8EE] border-t border-[#D5E6CF] text-center shrink-0 flex items-center justify-center z-20">
          <button
            onClick={handleReset}
            className="text-[11px] font-bold text-slate-500 hover:text-rose-600 flex items-center gap-1 cursor-pointer transition-colors px-3 py-1 rounded-lg hover:bg-rose-50"
          >
            <RotateCcw className="w-3 h-3" />
            <span>앱 초기화</span>
          </button>
        </footer>

        {/* Teacher/Admin Modal */}
        <AdminModal
          isOpen={isAdminOpen}
          onClose={() => setIsAdminOpen(false)}
          childrenData={childrenList}
          onUpdateChildren={handleUpdateChildrenData}
        />
      </div>
    </div>
  );
}
